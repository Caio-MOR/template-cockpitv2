# Allowlist (nega-tudo): o git versiona o que se LIBERA, não o que se esquece de negar.
# Um cockpit acumula planilhas, logs, .env e saídas de rotina ao lado do código; com
# deny-por-padrão, arquivo novo nunca entra por acidente — entrar é decisão explícita
# (uma linha `!` aqui). O preço é lembrar de liberar o que nasce; o lint de routers
# acusa referência a caminho que ficou fora do índice git.
/*

# Raiz — um a um
!/.gitignore
!/.gitleaksignore
!/.gitattributes
!/CLAUDE.md
!/AGENTS.md
!/README.md
!/SECURITY.md
!/requirements.txt
!/requirements.in
!/pytest.ini
!/conftest.py
!/.python-version
!/.env.example
!/pyproject.toml

# Pastas versionadas
!/.github/
!/.claude/
!/.codex/
!/tools/
!/docs/
!/tests/
!/workflows/
!/.specs/
!/apps/
!/evals/

# Logs de rotina ficam na máquina; só o .gitkeep entra para a pasta existir no clone
workflows/*/logs/*
!workflows/*/logs/.gitkeep

# Em qualquer profundidade
.env
.env.*
!/.env.example
.claude/settings.local.json
__pycache__/
*.pyc
.DS_Store
.pytest_cache/
.tmp/
evals/results/
