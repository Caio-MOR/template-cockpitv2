{
  "hooks": {
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR/.claude/hooks/run_hook.sh\" precompact_contexto.py",
            "statusMessage": "Preservando contexto essencial",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR/.claude/hooks/run_hook.sh\" sessionstart_contexto.py",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR/.claude/hooks/run_hook.sh\" guarda_bash.py",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR/.claude/hooks/run_hook.sh\" guarda_segredo.py",
            "timeout": 15
          }
        ]
      }
    ]
  },
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Edit(./.env)",
      "Edit(./.env.local)",
      "Write(./.env)",
      "Write(./.env.local)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git commit --no-verify*)"
    ],
    "allow": [
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git branch*)",
      "Bash(python -m pytest*)",
      "Bash(python3 -m pytest*)",
      "Bash(python tools/gate_veredito.py*)",
      "Bash(python3 tools/gate_veredito.py*)",
      "Bash(python tools/lint_routers.py*)",
      "Bash(python3 tools/lint_routers.py*)",
      "Bash(python tools/padrao_ouro_audit.py*)",
      "Bash(python3 tools/padrao_ouro_audit.py*)"
    ]
  },
  "env": {
    "CLAUDE_CODE_SUBAGENT_MODEL": "sonnet"
  },
  "extraKnownMarketplaces": {
    "caio-mor": {
      "source": {
        "source": "github",
        "repo": "Caio-MOR/plugins"
      }
    }
  },
  "enabledPlugins": {
    "tlc-spec-driven@caio-mor": true,
    "systematic-debugging@caio-mor": true,
    "os-audit@caio-mor": true
  }
}
